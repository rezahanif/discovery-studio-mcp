# BIOVIA Discovery Studio MCP Server Configuration
# Copy to .env and adjust values

# Discovery Studio installation root
DS_HOME=C:\Program Files\BIOVIA\Discovery Studio 2020

# Discovery Studio executable
DS_EXECUTABLE=C:\Program Files\BIOVIA\Discovery Studio 2020\bin\DiscoveryStudio2020.exe

# Perl executable (bundled with Discovery Studio)
DS_PERL_EXECUTABLE=C:\Program Files\BIOVIA\Discovery Studio 2020\bin\perl.exe

# Pipeline Pilot Server URL (required for protocol execution)
DS_PIPELINE_PILOT_URL=localhost:9943
DS_PIPELINE_PILOT_USERNAME=
DS_PIPELINE_PILOT_PASSWORD=

# Allowed input directories (semicolon-separated on Windows)
DS_ALLOWED_INPUT_DIRS=C:\Users\%USERNAME%\Documents

# Output directory for jobs and results
DS_OUTPUT_DIR=./workspace

# Maximum input file size in MB
DS_MAX_FILE_SIZE_MB=500

# Maximum concurrent jobs
DS_MAX_CONCURRENT_JOBS=1

# Job timeout in seconds
DS_JOB_TIMEOUT_SECONDS=3600

# Enable UI automation fallback (requires GUI, disabled by default)
DS_ENABLE_UI_FALLBACK=false

# Mock mode (for development without Discovery Studio)
DS_MOCK_MODE=true
